rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isManager() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }
    // Data 'AAAA-MM-DD' é hoje ou futura (UTC).
    function notPast(date) {
      let p = date.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(1, 'd') > request.time;
    }

    // Perfis: cada utilizador cria o seu com role 'passenger'; o role nunca é alterado pelo cliente.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'passenger';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }

    // Frota: leitura para autenticados, escrita só para gestor, sem eliminação física.
    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if isManager()
        && request.resource.data.vehicleId == vehicleId
        && vehicleId.matches('^[a-z0-9_]+$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.status in ['active', 'maintenance', 'inactive']
        && request.resource.data.batteryLevel is int
        && request.resource.data.batteryLevel >= 0 && request.resource.data.batteryLevel <= 100;
      allow delete: if false;
    }

    // Reservas: ID determinístico veiculo_data_bloco impede sobreposição
    // (um create sobre um ID existente é rejeitado pelo próprio Firestore).
    match /reservations/{reservationId} {
      // A grelha Veículo x Bloco Horário precisa de ver todos os blocos ocupados.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reservationId', 'vehicleId', 'userId', 'passengerName',
             'pickupPoint', 'dropoffPoint', 'date', 'timeSlot', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'booked'
        && request.resource.data.reservationId == reservationId
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.timeSlot.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && reservationId == request.resource.data.vehicleId + '_'
             + request.resource.data.date.replace('-', '') + '_'
             + request.resource.data.timeSlot.replace(':', '')
        && request.resource.data.pickupPoint != request.resource.data.dropoffPoint
        && request.resource.data.passengerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && notPast(request.resource.data.date)
        && !exists(/databases/$(database)/documents/reservations/$(reservationId))
        && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.status == 'active';
      // Simulação: só o gestor avança o estado da viagem; nada mais muda.
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['booked', 'in_progress', 'completed'];
      // Cancelar = apagar, o que liberta o bloco. O passageiro só cancela antes de a viagem começar.
      allow delete: if signedIn()
        && ((resource.data.userId == request.auth.uid && resource.data.status == 'booked') || isManager());
    }
  }
}
