rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessão iniciada e e-mail confirmado pelo link enviado na criação da conta.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isManager() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }
    // O bloco 'AAAA-MM-DD' + 'HH:MM' ainda não começou.
    // shortcut: hora lida como UTC (= Lisboa no inverno, 1h de folga no verão); usar fuso se a app sair de PT.
    function slotNotPast(date, slot) {
      let p = date.split('-');
      let t = slot.split(':');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]))
        + duration.value(int(t[0]) * 60 + int(t[1]), 'm') > request.time;
    }
    // Reservas só até 30 dias à frente: ninguém bloqueia a frota com datas longínquas.
    function withinHorizon(date) {
      let p = date.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) <= request.time + duration.value(30, 'd');
    }
    function campusPoints() {
      return ['Entrada Norte', 'Entrada Sul', 'Biblioteca', 'Cantina', 'Residências', 'Parque de Estacionamento'];
    }
    function validName(name) { return name is string && name.size() > 0 && name.size() <= 80; }
    // Abaixo disto o veículo não aceita reservas novas (precisa de carregar).
    function minBattery() { return 20; }
    function ownsCompletedReservation(reservationId) {
      let reservationPath = /databases/$(database)/documents/reservations/$(reservationId);
      return exists(reservationPath)
        && get(reservationPath).data.userId == request.auth.uid
        && get(reservationPath).data.status == 'completed';
    }

    // Perfis: cada utilizador cria o seu com role 'passenger'; o role nunca é alterado pelo cliente.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      // O perfil nasce no registo, antes da confirmação do e-mail.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.name)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.role == 'passenger';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
      allow delete: if false;
    }

    // Frota: leitura para autenticados, escrita só para gestor, sem eliminação física.
    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if isManager()
        && request.resource.data.vehicleId == vehicleId
        && vehicleId.matches('^[a-z0-9_]+$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.currentLocation is string && request.resource.data.currentLocation.size() <= 60
        && request.resource.data.status in ['active', 'maintenance', 'inactive']
        && request.resource.data.batteryLevel is int
        && request.resource.data.batteryLevel >= 0 && request.resource.data.batteryLevel <= 100;
      allow delete: if false;
    }

    // Reservas: ID determinístico veiculo_data_bloco impede sobreposição
    // (um create sobre um ID existente é rejeitado pelo próprio Firestore).
    match /reservations/{reservationId} {
      // Dados pessoais (quem, de onde, para onde): só o próprio passageiro e o gestor.
      // A grelha de ocupação lê a coleção pública /slots, que só diz que o bloco está ocupado.
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reservationId', 'vehicleId', 'userId', 'passengerName',
             'pickupPoint', 'dropoffPoint', 'date', 'timeSlot', 'status', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.pickupPoint in campusPoints()
        && request.resource.data.dropoffPoint in campusPoints()
        && withinHorizon(request.resource.data.date)
        // A reserva e o bloco público nascem no mesmo batch: ou os dois ou nenhum.
        && existsAfter(/databases/$(database)/documents/slots/$(reservationId))
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'booked'
        && request.resource.data.reservationId == reservationId
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.timeSlot.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && reservationId == request.resource.data.vehicleId + '_'
             + request.resource.data.date.replace('-', '') + '_'
             + request.resource.data.timeSlot.replace(':', '')
        && request.resource.data.pickupPoint != request.resource.data.dropoffPoint
        && request.resource.data.passengerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && slotNotPast(request.resource.data.date, request.resource.data.timeSlot)
        && !exists(/databases/$(database)/documents/reservations/$(reservationId))
        && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.status == 'active'
        && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.batteryLevel >= minBattery();
      // Simulação: só o gestor avança o estado da viagem, sempre para a frente
      // (Reservada → Em curso → Concluída); nada mais muda.
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'booked' && request.resource.data.status == 'in_progress')
          || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed'));
      // Cancelar = apagar, o que liberta o bloco. O passageiro só cancela antes de a viagem começar.
      // O gestor não apaga viagens concluídas (histórico e estatísticas). O bloco público sai no mesmo batch.
      allow delete: if signedIn()
        && ((resource.data.userId == request.auth.uid && resource.data.status == 'booked')
          || (isManager() && resource.data.status != 'completed'))
        && !existsAfter(/databases/$(database)/documents/slots/$(reservationId));
    }

    // Ocupação pública: um documento por bloco reservado, sem dados pessoais (só veículo, data e hora).
    match /slots/{reservationId} {
      allow read: if signedIn();
      // Criado com a reserva (mesmo batch) pelo dono, ou pelo gestor para reservas antigas sem bloco.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['vehicleId', 'date', 'timeSlot'])
        && request.resource.data.keys().hasAll(['vehicleId', 'date', 'timeSlot'])
        && existsAfter(/databases/$(database)/documents/reservations/$(reservationId))
        && getAfter(/databases/$(database)/documents/reservations/$(reservationId)).data.vehicleId == request.resource.data.vehicleId
        && getAfter(/databases/$(database)/documents/reservations/$(reservationId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/reservations/$(reservationId)).data.timeSlot == request.resource.data.timeSlot
        && (getAfter(/databases/$(database)/documents/reservations/$(reservationId)).data.userId == request.auth.uid || isManager());
      allow update: if false;
      // Sai com a reserva (mesmo batch, autorizado pela regra de delete da reserva); blocos órfãos só o gestor limpa.
      allow delete: if signedIn()
        && !existsAfter(/databases/$(database)/documents/reservations/$(reservationId))
        && (exists(/databases/$(database)/documents/reservations/$(reservationId)) || isManager());
    }

    // Feedback: uma avaliação por viagem concluída, enviada pelo próprio passageiro.
    match /feedback/{reservationId} {
      allow read: if isManager() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reservationId', 'userId', 'vehicleId', 'rating', 'comment', 'createdAt'])
        && request.resource.data.keys().hasAll(['reservationId', 'userId', 'vehicleId', 'rating', 'comment', 'createdAt'])
        && request.resource.data.reservationId == reservationId
        && request.resource.data.userId == request.auth.uid
        && ownsCompletedReservation(reservationId)
        && request.resource.data.vehicleId == get(/databases/$(database)/documents/reservations/$(reservationId)).data.vehicleId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
